[Unit]
Description=DK Capital opt-in DEMO-only Account 3 frozen-terminal recovery
After=docker.service dkcapital-mt5-3.service

[Service]
Type=oneshot
WorkingDirectory=/opt/dkcapital
ExecStart=/usr/bin/python3 /opt/dkcapital/scripts/mt5_terminal_autoheal.py --account-id 3 --apply
TimeoutStartSec=120
NoNewPrivileges=true
