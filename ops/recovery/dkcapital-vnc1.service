[Unit]
Description=DK Capital MT5 Account 1 VNC (SSH tunnel only)
After=network-online.target dkcapital-mt5-1.service
Wants=dkcapital-mt5-1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=dkmt5
Group=dkmt5
WorkingDirectory=/var/lib/dkcapital-mt5
Environment=HOME=/var/lib/dkcapital-mt5
Environment=XAUTHORITY=/var/lib/dkcapital-mt5/.Xauthority
ExecStartPre=/usr/bin/timeout 90 /bin/sh -c 'until test -S /tmp/.X11-unix/X150; do sleep 2; done'
ExecStart=/usr/bin/x11vnc -display :150 -auth /var/lib/dkcapital-mt5/.Xauthority -rfbport 5901 -localhost -forever -shared -rfbauth /var/lib/dkcapital-mt5/.vnc/passwd -o /tmp/dkcapital-vnc1.log
Restart=always
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
