# Hard safety boundary. This executor supports shadow mode only.
MT5_SHADOW_ONLY=true

# The Ubuntu gateway should normally be reached through an SSH tunnel.
MT5_GATEWAY_URL=http://127.0.0.1:8765
MT5_GATEWAY_TOKEN=

# Optional. Leave login/password/server blank to use the account already logged
# into the locally installed MT5 terminal.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_ACCOUNT_LOGIN=
MT5_ACCOUNT_PASSWORD=
MT5_ACCOUNT_SERVER=

# Broker symbol override. The executor can also discover common XAUUSD/GOLD suffixes.
MT5_SYMBOL=XAUUSD

# 0.005 = 0.50% shadow risk per newly observed signal.
MT5_SHADOW_RISK_PCT=0.005
MT5_SHADOW_MAX_SIGNAL_AGE_SECONDS=180
MT5_POLL_SECONDS=2
MT5_HTTP_TIMEOUT_SECONDS=10
MT5_SHADOW_STATE_PATH=windows/data/mt5-shadow.json
LOG_LEVEL=INFO
