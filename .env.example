APP_ENV=production
LOG_LEVEL=INFO

# Telegram application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generate this with: docker compose run --rm telegram-session
TELEGRAM_SESSION_STRING=

# Comma-separated Telegram channel/group IDs or usernames.
# Examples:
# TELEGRAM_SOURCE_CHATS=-1001234567890
# TELEGRAM_SOURCE_CHATS=-1001234567890,@examplechannel
TELEGRAM_SOURCE_CHATS=

# Durable raw Telegram event stream and derived live signal state.
TELEGRAM_EVENT_LOG_PATH=/app/data/telegram-events.jsonl
SIGNAL_STATE_PATH=/app/data/signal-state.json

# Discord dashboard bot.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DASHBOARD_CONFIG_PATH=/app/data/discord-dashboard.json

# Internal parsed-signal feed. Defaults to the current DK Capital internal signals channel.
DISCORD_INTERNAL_SIGNALS_CHANNEL_ID=1554231371013169235
DISCORD_INTERNAL_SIGNALS_STATE_PATH=/app/data/discord-internal-signals.json


# Display times in Isle of Man local time, including BST/GMT daylight changes.
DISPLAY_TIMEZONE=Europe/Isle_of_Man

# Indicative XAU/USD spot data for active gold signals.
# Anonymous goldprice.dev access is refreshed once per minute by default.
GOLD_SPOT_URL=https://api.goldprice.dev/v1/prices?symbol=XAU-USD-SPOT
GOLD_SPOT_REFRESH_SECONDS=60


# XAUUSD paper-trading engine.
# The engine starts with a virtual $100,000 account and observes every parsed
# XAUUSD signal. Execution stays disabled until a strategy is explicitly set.
PAPER_STATE_PATH=/app/data/paper-trading.json
PAPER_EVENT_LOG_PATH=/app/data/paper-trade-events.jsonl
PAPER_STARTING_BALANCE_USD=100000
PAPER_SYMBOL=XAUUSD
PAPER_STRATEGY_MODE=observe_only
# Every parsed XAUUSD signal is selected for entry. Position sizing/execution
# remains pending until the trading strategy is configured.
PAPER_ENTRY_POLICY=all_parsed
PAPER_MARK_REFRESH_SECONDS=15
PAPER_XAU_PIP_SIZE=0.01

# Permanent Discord paper-trading dashboard.
PAPER_DASHBOARD_CHANNEL_ID=1554479167024926820
PAPER_DASHBOARD_STATE_PATH=/app/data/paper-dashboard.json
